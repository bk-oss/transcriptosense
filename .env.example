# ============================================================
# TranscriptoSense — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# HuggingFace token — required for pyannote diarization models
# Get yours at: https://huggingface.co/settings/tokens
# Also accept model terms at: https://huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=hf_YOUR_TOKEN_HERE

# Optional: OpenAI key (only if you want GPT-based summarization as a fallback)
# OPENAI_API_KEY=sk-...

# App settings
APP_ENV=development           # development | production
LOG_LEVEL=INFO
MAX_UPLOAD_MB=200
